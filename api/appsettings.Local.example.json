{
  "ConnectionStrings": {
    "SportsBettingDb": "POSTGRES_CONNECTION_STRING"
  },
  "TheOddsApi": {
    "ApiKey": "THE_ODDS_API_KEY",
    "MaxConcurrentRequests": 3
  },
  "TheOddsIngestionWorker": {
    "ExpandedBookmakers": "draftkings,fanduel,betmgm,espnbet,betrivers,fanatics,williamhill_us,betonlineag,bovada,lowvig,mybookieag",
    "IncludeDfsBookmakers": false,
    "DfsRegion": "us_dfs",
    "DfsBookmakers": "prizepicks,underdog,pick6,betr_us_dfs"
  },
  "TheOddsScheduledRefresh": {
    "Enabled": true,
    "IntervalMinutes": 15,
    "BookmakerPreset": "dfsOnly",
    "IncludeCandidates": true,
    "IncludeLineShopping": true,
    "IncludeFullDiagnostics": false,
    "FreshnessMinutes": 30,
    "RequireForceLive": true,
    "AllowScheduledLiveRefresh": true,
    "AllowEventDiscoveryWhenNoPersistedEvents": true,
    "FallbackEstimatedApiCalls": 8,
    "PostRefreshReadBufferSeconds": 30
  },
  "TheOddsRefreshPlanner": {
    "Enabled": true,
    "DefaultBookmakerPreset": "dfsOnly",
    "PlannerIntervalSeconds": 60,
    "MaxDailyCredits": 500,
    "MaxMonthlyCredits": 100000,
    "WarnAtDailyPercent": 80,
    "WarnAtMonthlyPercent": 80,
    "HardStopAtDailyPercent": 100,
    "HardStopAtMonthlyPercent": 100,
    "ProviderRemainingHardStopCredits": 5,
    "RetryAfterFailureMinutes": 1,
    "StopAfterEventStart": false
  },
  "UnderdogIngestion": {
    "Enabled": false,
    "IntervalMinutes": 15
  },
  "DebugAdmin": {
    "ApiKey": "DEBUG_ADMIN_KEY"
  }
}
